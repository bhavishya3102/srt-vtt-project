{
  "name": "course-qa",
  "version": "1.0.0",
  "description": "Ask your video course anything — grounded answers with module, chapter and a clickable timestamp",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "ingest": "node scripts/ingest-course.js",
    "titles:generate": "node scripts/generate-titles.js",
    "test": "node --test \"test/*.test.js\"",
    "ui": "npm --prefix web run dev",
    "ui:install": "npm --prefix web install",
    "ui:build": "npm --prefix web run build",
    "ui:lint": "npm --prefix web run lint",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "dependencies": {
    "@bull-board/api": "^8.3.2",
    "@bull-board/express": "^8.3.2",
    "@qdrant/js-client-rest": "^1.13.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "openai": "^4.77.0"
  }
}
