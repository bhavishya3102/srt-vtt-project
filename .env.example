# Copy to .env and fill in OPENAI_API_KEY:  cp .env.example .env

# ---- Server ----
PORT=8000

# Bull Board queue dashboard mount point. NO AUTH — localhost only.
QUEUE_DASHBOARD_PATH=/admin/queues

# ---- Course transcripts ----
# Either a single course:      <path>/module 1/<lesson>/<lesson>.srt
# or a parent of several:      <path>/<course>/module 1/<lesson>/<lesson>.srt
# The layout is detected automatically, so existing folders never need moving.
COURSE_PATH=class_subtitle_lyst1784566935215/class-subtitle

# Display name used when COURSE_PATH is a single course.
COURSE_NAME=Expo Mastery

# Read every lesson's last cue at startup so the catalog knows lesson lengths.
# Costs ~200ms for 87 files; set to false only for a much larger library.
SCAN_DURATIONS=true

# ---- Redis (BullMQ queues) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- Qdrant (vector store) ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=course_transcripts

# ---- OpenAI ----
OPENAI_API_KEY=

# text-embedding-3-small -> 1536 dims | text-embedding-3-large -> 3072 dims
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# ---- Chunking ----
# Measured against this corpus: the average cue is 52 chars, so 1200 is roughly
# 23 cues (60-70s of speech). A >=1500ms pause occurs every ~871 chars, just
# under the target, which lets most chunks close on a real pause.
CHUNK_TARGET_CHARS=1200
CHUNK_MIN_CHARS=600
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=240
CHUNK_STRONG_PAUSE_MS=1500
# 25% of cues carry no sentence-ending punctuation; this caps the resulting runs.
MAX_SENTENCE_CHARS=400

# ---- Retrieval ----
RETRIEVAL_TOP_K=6
RRF_K=60
RETRIEVAL_FINAL_K=6
MAX_QUERY_CHARS=2000

# ---- Ingest ----
# Lessons embedded in parallel. Keep modest: each lesson is several embedding
# requests and OpenAI rate-limits per minute.
INGEST_CONCURRENCY=3
